{
  "name": "@dgtx/ui-frek",
  "version": "0.1.1",
  "type": "module",
  "description": "DIGI-TEXX React components and design tokens (Base UI + plain CSS).",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "dtx-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css",
    "./theme.css": "./tokens/theme.css",
    "./fonts.css": "./tokens/fonts.css",
    "./tailwind.css": "./tokens/tailwind.css",
    "./assets/*": {
      "dtx-source": "./src/assets/*",
      "default": "./dist/assets/*"
    }
  },
  "files": [
    "dist",
    "src/**/*.css",
    "tokens/*.css"
  ],
  "publishConfig": {
    "registry": "https://nexus.digi-texx.vn/repository/npm-xteam/"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/roboto": "^5.3.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.52.0",
    "pdfjs-dist": "^6.4.299"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node build.mjs",
    "prepack": "npm run build",
    "test": "node tokens/contrast.test.mjs && node theme.check.mjs && node --experimental-strip-types --no-warnings --test \"src/**/*.check.ts\""
  }
}
